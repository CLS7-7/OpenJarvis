# Copy to .env and fill in on the server. Never commit .env.
# Required: at least 32 random characters, e.g. generated with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional (defaults to /data inside the container)
DATA_DIR=/data
# Optional: Hermes bridge on the Windows desktop
BRIDGE_URL=
BRIDGE_SECRET=
# Optional: ElevenLabs voice agent (agent must have authentication enabled)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
